rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS ──────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function isOwner() {
      return isAuth() && request.auth.token.role == 'owner';
    }

    function isAdmin() {
      return isAuth() && request.auth.token.role == 'admin';
    }

    function isOwnerOrAdmin() {
      return isOwner() || isAdmin();
    }

    function isOwnerDoc(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function hasOwnerRole() {
      return isAuth()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    function hasAdminRole() {
      return isAuth()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'owner'];
    }

    // ─── USERS / STUDENT PROFILES ─────────────────────────────

    match /users/{userId} {
      allow read: if isAuth();

      allow create: if isOwnerDoc(userId);

      allow update: if isOwnerDoc(userId) || isOwnerOrAdmin() || hasOwnerRole() || hasAdminRole();

      // Users can delete their own account (self-deletion)
      // Admin/owner can delete any non-owner account
      allow delete: if isOwnerDoc(userId)
        || ((isOwnerOrAdmin() || hasOwnerRole() || hasAdminRole())
            && get(/databases/$(database)/documents/users/$(userId)).data.role != 'owner');

      // Resume chunks subcollection — owner can read/write their own resume data
      match /resumeChunks/{chunkId} {
        allow read: if isOwnerDoc(userId);
        allow create, update, delete: if isOwnerDoc(userId);
      }
    }

    // ─── COMPANIES ─────────────────────────────────────────────

    match /companies/{companyId} {
      allow read: if isAuth();
      allow create, update, delete: if isOwnerOrAdmin() || hasAdminRole();
    }

    // ─── JOBS / PLACEMENT DRIVES ──────────────────────────────

    match /jobs/{jobId} {
      allow read: if isAuth();
      allow create, update, delete: if isOwnerOrAdmin() || hasAdminRole();
    }

    // ─── APPLICATIONS ─────────────────────────────────────────

    match /applications/{applicationId} {
      allow read: if isOwnerDoc(resource.data.userId) || isOwnerOrAdmin() || hasAdminRole();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwnerDoc(resource.data.userId) || isOwnerOrAdmin() || hasAdminRole();
      allow delete: if isOwnerDoc(resource.data.userId) || isOwnerOrAdmin() || hasAdminRole();
    }

    // ─── ANNOUNCEMENTS ────────────────────────────────────────

    match /announcements/{announcementId} {
      allow read: if isAuth();
      allow create, update, delete: if isOwnerOrAdmin() || hasAdminRole();
    }

    // ─── ATTACHMENTS ─────────────────────────────────────────

    match /attachments/{attachmentId} {
      allow read: if isAuth();
      allow create, update, delete: if isOwnerOrAdmin() || hasAdminRole();
    }

    // ─── NOTIFICATIONS ────────────────────────────────────────

    match /notifications/{notificationId} {
      // Only the recipient can read their notifications
      allow read: if isAuth() && request.auth.uid == resource.data.targetUserId;

      // Authenticated users can create notifications; sender must be the authenticated user
      allow create: if isAuth()
        && request.resource.data.senderId == request.auth.uid;

      // Only the recipient can update (mark as read)
      allow update: if isAuth() && request.auth.uid == resource.data.targetUserId;

      // Only the recipient or admin/owner can delete
      allow delete: if isAuth()
        && (request.auth.uid == resource.data.targetUserId
          || isOwnerOrAdmin() || hasAdminRole());
    }

    // ─── FOLLOWS ──────────────────────────────────────────────

    match /follows/{followId} {
      allow read: if isAuth();

      // Only the sender can create a follow request
      allow create: if isAuth()
        && request.auth.uid == request.resource.data.fromUserId
        && request.resource.data.toUserId != request.auth.uid;

      // Either participant can update (accept, auto-accept, follow-back)
      allow update: if isAuth()
        && (request.auth.uid == resource.data.fromUserId
          || request.auth.uid == resource.data.toUserId);

      // Either participant or admin/owner can delete (cancel, unfollow, remove, account cleanup)
      allow delete: if isAuth()
        && (request.auth.uid == resource.data.fromUserId
          || request.auth.uid == resource.data.toUserId
          || isOwnerOrAdmin() || hasAdminRole());
    }

    // ─── CONVERSATIONS ────────────────────────────────────────

    match /conversations/{conversationId} {
      allow read: if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() && request.auth.uid in request.resource.data.participants;
      // Only participants can update conversation metadata; admin/owner can update for cleanup
      allow update: if isAuth()
        && (request.auth.uid in resource.data.participants
          || isOwnerOrAdmin() || hasAdminRole());
      // Admin/owner can delete conversations during user account cleanup
      allow delete: if isAuth() && (isOwnerOrAdmin() || hasAdminRole());
    }

    // ─── MESSAGES ─────────────────────────────────────────────

    match /messages/{messageId} {
      allow read: if isAuth()
        && resource.data.conversationId != null
        && exists(/databases/$(database)/documents/conversations/$(resource.data.conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participants;

      allow create: if isAuth()
        && request.resource.data.conversationId != null
        && exists(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participants;

      allow update: if isAuth()
        && resource.data.conversationId != null
        && exists(/databases/$(database)/documents/conversations/$(resource.data.conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participants;

      // Admin/owner can delete messages during user account cleanup
      allow delete: if isAuth() && (isOwnerOrAdmin() || hasAdminRole());
    }

    // ─── USER KEYS (E2EE PUBLIC KEY DIRECTORY) ─────────────────

    match /userKeys/{userKeyId} {
      // Any authenticated user can read public keys for E2EE key exchange
      allow read: if isAuth();
      // Only the key owner can write their own public key
      allow create, update: if isAuth() && request.auth.uid == userKeyId;
      // Key owner or admin/owner can delete (account cleanup)
      allow delete: if isAuth() && (request.auth.uid == userKeyId || isOwnerOrAdmin() || hasAdminRole());
    }

    // ─── BLOCKS ───────────────────────────────────────────────

    match /blocks/{blockId} {
      // Both the blocker and the blocked user can read (for block status checks)
      allow read: if isAuth()
        && (request.auth.uid == resource.data.blockerId
          || request.auth.uid == resource.data.blockedId);

      // Only the blocker can create their own block
      allow create: if isAuth()
        && request.auth.uid == request.resource.data.blockerId;

      // The blocker or admin/owner can delete (unblock, or account cleanup)
      allow delete: if isAuth()
        && (request.auth.uid == resource.data.blockerId
          || isOwnerOrAdmin() || hasAdminRole());
    }

    // ─── REPORTS ──────────────────────────────────────────────

    match /reports/{reportId} {
      allow read: if isOwnerOrAdmin() || hasAdminRole() || resource.data.reporterId == request.auth.uid;
      allow create: if isAuth();
      allow update: if isOwnerOrAdmin() || hasAdminRole();
    }

    // ─── MODERATIONS ──────────────────────────────────────────

    match /moderations/{moderationId} {
      allow read: if isOwnerOrAdmin() || hasAdminRole();
      allow create: if isOwnerOrAdmin() || hasAdminRole();
    }

    // ─── ADMIN CONVERSATIONS ─────────────────────────────────

    match /adminConversations/{convId} {
      allow read: if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuth() && request.auth.uid in resource.data.participants;
      // Admin/owner can delete during user account cleanup
      allow delete: if isAuth() && (isOwnerOrAdmin() || hasAdminRole());
    }

    // ─── ADMIN MESSAGES ──────────────────────────────────────

    match /adminMessages/{msgId} {
      allow read: if isAuth()
        && resource.data.conversationId != null
        && exists(/databases/$(database)/documents/adminConversations/$(resource.data.conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/adminConversations/$(resource.data.conversationId)).data.participants;

      allow create: if isAuth()
        && request.resource.data.conversationId != null
        && exists(/databases/$(database)/documents/adminConversations/$(request.resource.data.conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/adminConversations/$(request.resource.data.conversationId)).data.participants;

      // Admin/owner can delete during user account cleanup
      allow delete: if isAuth() && (isOwnerOrAdmin() || hasAdminRole());
    }

    // ─── SUPPORT TICKETS ──────────────────────────────────────

    match /supportTickets/{ticketId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isOwnerOrAdmin() || hasAdminRole());
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && (resource.data.userId == request.auth.uid || isOwnerOrAdmin() || hasAdminRole());
      allow delete: if isOwnerOrAdmin() || hasAdminRole();

      match /messages/{messageId} {
        allow read: if isAuth()
          && (get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.userId == request.auth.uid
            || isOwnerOrAdmin() || hasAdminRole());

        allow create: if isAuth()
          && (get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.userId == request.auth.uid
            || isOwnerOrAdmin() || hasAdminRole());
      }
    }

    // ─── DENY ALL OTHER COLLECTIONS ───────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
