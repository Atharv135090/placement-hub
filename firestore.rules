rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS ──────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function isOwner() {
      return isAuth() && request.auth.token.role == 'owner';
    }

    function isAdmin() {
      return isAuth() && request.auth.token.role == 'admin';
    }

    function isOwnerOrAdmin() {
      return isOwner() || isAdmin();
    }

    function isOwnerDoc(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Check users/{uid} document for role (works without custom claims)
    // exists() guard prevents get() from failing when the document doesn't exist yet
    function hasOwnerRole() {
      return isAuth()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    function hasAdminRole() {
      return isAuth()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner');
    }

    function isConversationParticipant(convId) {
      return isAuth()
        && exists(/databases/$(database)/documents/conversations/$(convId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
    }

    // ─── COMPANIES ─────────────────────────────────────────────

    match /companies/{companyId} {
      // Anyone authenticated can read companies
      allow read: if isAuth();

      // Only owner/admin can create, update, delete
      // Checks both custom claims AND users/{uid} document
      allow create, update, delete: if isOwnerOrAdmin() || hasAdminRole();
    }

    // ─── JOBS / PLACEMENT DRIVES ──────────────────────────────

    match /jobs/{jobId} {
      // Anyone authenticated can read jobs
      allow read: if isAuth();

      // Only owner/admin can create, update, delete
      // Checks both custom claims AND users/{uid} document
      allow create, update, delete: if isOwnerOrAdmin() || hasAdminRole();
    }

    // ─── USERS / STUDENT PROFILES ─────────────────────────────

    match /users/{userId} {
      // Users can read any profile (needed for displaying names, etc.)
      allow read: if isAuth();

      // Users can create their own profile only
      allow create: if isOwnerDoc(userId);

      // Users can update their own profile
      // Owner/admin can update any profile (for role management)
      // Allow self-update for role promotion
      allow update: if isOwnerDoc(userId) || isOwnerOrAdmin() || hasOwnerRole() || hasAdminRole();

      // Only owner/admin can delete user profiles
      allow delete: if isOwnerOrAdmin() || hasOwnerRole() || hasAdminRole();
    }

    // ─── APPLICATIONS ─────────────────────────────────────────

    match /applications/{applicationId} {
      // Students can read their own applications
      // Owner/admin can read all applications
      allow read: if isOwnerDoc(resource.data.userId) || isOwnerOrAdmin() || hasAdminRole();

      // Students can create their own application
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid;

      // Students can update their own application (e.g. withdraw)
      // Owner/admin can update any application (status changes)
      allow update: if isOwnerDoc(resource.data.userId) || isOwnerOrAdmin() || hasAdminRole();

      // Students can delete their own application (withdraw)
      // Owner/admin can delete any application
      allow delete: if isOwnerDoc(resource.data.userId) || isOwnerOrAdmin() || hasAdminRole();
    }

    // ─── ANNOUNCEMENTS ────────────────────────────────────────

    match /announcements/{announcementId} {
      // Anyone authenticated can read announcements
      allow read: if isAuth();

      // Only owner/admin can create, update, delete
      allow create, update, delete: if isOwnerOrAdmin() || hasAdminRole();
    }

    // ─── ATTACHMENTS ─────────────────────────────────────────

    match /attachments/{attachmentId} {
      // Anyone authenticated can read attachments
      allow read: if isAuth();

      // Only owner/admin can create, update, delete
      allow create, update, delete: if isOwnerOrAdmin() || hasAdminRole();
    }

    // ─── NOTIFICATIONS ────────────────────────────────────────

    match /notifications/{notificationId} {
      // Anyone authenticated can read notifications
      allow read: if isAuth();

      // Authenticated users can create notifications (for follow requests etc.)
      allow create: if isAuth();

      // Users can update readBy array (mark as read)
      // Owner/admin can update any notification
      allow update: if isAuth();

      // Only owner/admin can delete notifications
      allow delete: if isOwnerOrAdmin() || hasAdminRole();
    }

    // ─── FOLLOWS ──────────────────────────────────────────────

    match /follows/{followId} {
      // Anyone authenticated can read follows (needed for subscriptions)
      allow read: if isAuth();

      // Only the sender (fromUserId) can create a follow request
      // Prevents impersonation: you cannot create a follow pretending to be someone else
      allow create: if isAuth()
        && request.auth.uid == request.resource.data.fromUserId
        && request.resource.data.toUserId != request.auth.uid;

      // Only the target (toUserId) can update (accept/reject a request)
      // Prevents the sender from force-accepting their own request
      allow update: if isAuth()
        && request.auth.uid == resource.data.toUserId;

      // Either participant can delete (cancel, unfollow, or remove follower)
      // Prevents third-party deletion of other users' relationships
      allow delete: if isAuth()
        && (request.auth.uid == resource.data.fromUserId
          || request.auth.uid == resource.data.toUserId);
    }

    // ─── CONVERSATIONS ────────────────────────────────────────

    match /conversations/{conversationId} {
      allow read: if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth();
      allow update: if isAuth() && request.auth.uid in resource.data.participants;
    }

    // ─── MESSAGES ─────────────────────────────────────────────

    match /messages/{messageId} {
      // Only conversation participants can read messages
      allow read: if isAuth()
        && resource.data.conversationId != null
        && exists(/databases/$(database)/documents/conversations/$(resource.data.conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participants;

      // Only conversation participants can create messages
      allow create: if isAuth()
        && request.resource.data.conversationId != null
        && exists(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participants;

      // Only conversation participants can update messages (mark as read)
      allow update: if isAuth()
        && resource.data.conversationId != null
        && exists(/databases/$(database)/documents/conversations/$(resource.data.conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participants;
    }

    // ─── BLOCKS ───────────────────────────────────────────────

    match /blocks/{blockId} {
      allow read: if isAuth();

      // Only the blocker can create their own block
      allow create: if isAuth()
        && request.auth.uid == request.resource.data.blockerId;

      // Only the blocker can delete their own block (unblock)
      allow delete: if isAuth()
        && request.auth.uid == resource.data.blockerId;
    }

    // ─── REPORTS ──────────────────────────────────────────────

    match /reports/{reportId} {
      allow read: if isOwnerOrAdmin() || hasAdminRole() || resource.data.reporterId == request.auth.uid;
      allow create: if isAuth();
      allow update: if isOwnerOrAdmin() || hasAdminRole();
    }

    // ─── DENY ALL OTHER COLLECTIONS ───────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
